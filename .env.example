# OpenAI-compatible vision LLM (leave empty => demo mode)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
# Shown on site; must match the email submitted to Waffo/Creem
SUPPORT_EMAIL=
# Hosted checkout links from Waffo or Creem
CHECKOUT_URL_PRO=
CHECKOUT_URL_CREDITS_100=
CHECKOUT_URL_CREDITS_500=
# Free tier pages per day per visitor
FREE_PAGES_PER_DAY=3
# Optional Upstash Redis for durable limits (otherwise cookie+in-memory IP)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Comma-separated license keys that bypass the free limit (issue to paying customers; Creem supports license keys)
LICENSE_KEYS=
SITE_URL=
